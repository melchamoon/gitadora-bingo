# デフォルト: テキストファイルは自動検出し LF で正規化
* text=auto eol=lf

# ソースコード
*.html text
*.css text
*.js text
*.json text
*.md text
*.yml text
*.yaml text

# スクリプト
*.sh text
*.rb text
*.py text

# バイナリファイル（diff を無効化）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# サードパーティ / 自動生成ファイル（GitHub 言語統計から除外）
*.min.js linguist-generated=true
*.min.css linguist-generated=true
js/main.js linguist-generated=true
js/tom-select.base.js linguist-generated=true
